{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash build.sh",
  "installCommand": "echo skip",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://dashin-flexin-api.vercel.app/api/:path*"
    },
    {
      "source": "/terms.html",
      "destination": "https://dashin-flexin-api.vercel.app/terms.html"
    },
    {
      "source": "/privacy.html",
      "destination": "https://dashin-flexin-api.vercel.app/privacy.html"
    },
    {
      "source": "/ai.html",
      "destination": "https://dashin-flexin-api.vercel.app/ai.html"
    },
    {
      "source": "/((?!_expo/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/_expo/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
