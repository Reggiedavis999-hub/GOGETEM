{
  "expo": {
    "name": "Dashin & Flexin",
    "slug": "gogetem-32xgtafm3p2xy8yzii9tt",
    "scheme": "dashinflexin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0b0d",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0b0d"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rhondasons.dashinandflexin",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.rhondasons.dashinandflexin",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0b0d"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#f0be2f",
          "defaultChannel": "block-reminders",
          "enableRemoteNotifications": false
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "apiBase": "https://dashin-flexin-api.vercel.app",
      "eas": {
        "projectId": "a940736f-5a50-44ea-a45b-46b7fb614868"
      }
    },
    "owner": "fullygogetems-team",
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    }
  }
}
