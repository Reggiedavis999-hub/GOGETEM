    "build:android": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --profile production"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "*",
    "expo": "~58.0.0",
    "expo-constants": "*",
    "expo-keep-awake": "*",
    "expo-linking": "*",
    "expo-router": "*",
    "expo-status-bar": "*",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "*",
    "react-native-screens": "*"
  },
  "devDependencies": {
    "@types/react": "*",
    "typescript": "*"
  }
}
