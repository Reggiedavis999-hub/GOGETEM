{
  "name": "dashin-and-flexin",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "setup": "npx expo install --fix",
    "typecheck": "tsc --noEmit",
