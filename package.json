{
  "name": "dashin-and-flexin",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "setup": "npx expo install --fix",
    "typecheck": "npx expo install typescript @types/react && tsc --noEmit",
    "test:logic": "node scripts/logic-test.js",
    "build:android": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --profile production",
    "web": "expo start --web",
    "build:web": "expo export -p web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.0",
    "expo-constants": "~58.0.16",
    "expo-document-picker": "~58.0.4",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.4",
    "expo-linear-gradient": "~58.0.0",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.0.0",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.0",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  }
}
